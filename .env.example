# ============================================================
# 采购文档智能生成系统 v2 —— 配置模板
# 作者：贾皓杰 (JHJ)
#
# 用法：复制本文件为 .env，然后按需修改
# ============================================================

APP_NAME=采购文档智能生成系统 v2
HOST=127.0.0.1
PORT=8000

# ---------- 数据库 ----------
# 方案A：SQLite（默认，零配置，直接能跑）
DATABASE_URL=sqlite
# 方案B：MySQL（改成下面这一行；数据库要先手动建好）
# DATABASE_URL=mysql+aiomysql://root:Jhj%40123456@127.0.0.1:3306/procurement_jhj?charset=utf8mb4
# 说明：密码里的 @ 要写成 %40，不然连接串会被截断
SQL_ECHO=false

# ---------- 登录凭证 ----------
# token 有效期（分钟）
TOKEN_EXPIRE_MINUTES=720

# ---------- 大模型（OpenAI 兼容协议；不填 API_KEY 就自动走本地规则） ----------
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=deepseek-ai/DeepSeek-V3
AI_TIMEOUT_SECONDS=30

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=20
